# Public, environment-scoped client configuration. Placeholders only -- never commit real values.
# Expo inlines EXPO_PUBLIC_* at build time, exactly as Vite does for the web client,
# so a release build must be produced with the values already set.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional. Base origin of the web client, used to build invitation links that
# also work for a recipient who has not installed the Android app.
EXPO_PUBLIC_WEB_ORIGIN=https://your-web-deployment.example
