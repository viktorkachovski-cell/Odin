{
  "name": "odin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:tooling": "node --test tooling/tests/*.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:diff": "supabase db schema declarative sync --strict-coverage --no-apply",
    "db:test": "supabase test db",
    "db:test:concurrency": "node supabase/tests/concurrency.mjs",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "check": "npm run lint && npm run format:check && npm run test:tooling"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "postgres": "3.4.9",
    "prettier": "3.6.2",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
