{
  "name": "odin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:mobile": "npm run test --workspace @odin/mobile",
    "test:tooling": "node --test tooling/tests/*.test.mjs",
    "build": "npm run build --workspace @odin/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:diff": "supabase db schema declarative sync --strict-coverage --no-apply",
    "db:test": "supabase test db",
    "db:test:concurrency": "node supabase/tests/concurrency.mjs",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:tooling && npm run test && npm run test:mobile"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postgres": "3.4.9",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  }
}
